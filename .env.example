# Ratiba configuration.
#
#   cp .env.example .env
#
# Every value here is a safe local-development default. Nothing in this file is
# a real credential, and .env itself is git-ignored. The full reference —
# purpose, whether a variable is required, and which values are secret — is in
# docs/operations.md.
#
# Configuration is validated once at startup. A bad value stops the process with
# an actionable message rather than causing a mysterious failure later.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | staging | production | test
# Production additionally requires JSON logs, a metrics token, and refuses pprof.
APP_ENV=development

# Reported in logs, metrics and traces.
SERVICE_NAME=ratiba-api

# The API's listening port. Railway injects this automatically; do not set it there.
PORT=8080

# ---------------------------------------------------------------------------
# Database  (REQUIRED — no default, the process will not start without it)
# ---------------------------------------------------------------------------

# SECRET. On Railway use the reference ${{Postgres.DATABASE_URL}} rather than a
# literal, so a rotated password propagates without a redeploy.
# These credentials match the Makefile's defaults and are local-only.
DATABASE_URL=postgres://ratiba:ratiba_local_dev@localhost:5432/ratiba?sslmode=disable

# Used by the local PostgreSQL container the Makefile starts.
POSTGRES_USER=ratiba
POSTGRES_PASSWORD=ratiba_local_dev
POSTGRES_DB=ratiba
POSTGRES_PORT=5432

# Pool size. Set this from the environment's connection budget divided by the
# replica count — not from a number copied out of a blog post. A Railway starter
# Postgres allows far fewer connections than you might assume.
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
# Server-side backstop: PostgreSQL cancels any statement running longer than this.
DB_STATEMENT_TIMEOUT=8s

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
# Must be shorter than HTTP_WRITE_TIMEOUT, or the timeout response cannot be sent.
HTTP_HANDLER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=20s
# Ratiba's largest legitimate request body is a few hundred bytes.
HTTP_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# debug | info | warn | error. Production refuses debug.
LOG_LEVEL=info
# json | text. Text is for humans at a terminal; production requires json.
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------

# The assessment's bonus rule: a slot is bookable when starts_at >= now + this.
# Set to 0s to disable the lead-time rule entirely.
BOOKING_MIN_LEAD_TIME=1h

# Slot duration is NOT configurable: it is fixed at 30 minutes by a CHECK
# constraint on the appointments table. Changing it requires a migration.

PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------

# Used by `make integration-test`. Set automatically by that target; override
# to point the integration suite at a different server.
# TEST_DATABASE_URL=postgres://ratiba:ratiba_local_dev@localhost:5432/ratiba_test?sslmode=disable
